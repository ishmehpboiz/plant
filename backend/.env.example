# Supabase Postgres connection string.
# Use the "Transaction pooler" URI (port 6543) from Supabase project settings > Database
# -- serverless functions (Vercel) open/close a connection per invocation, and the
# transaction pooler handles that far better than a direct connection.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Not required until step 3 (Plant.id species integration). Leave unset to use
# the species-ID stub.
PLANT_ID_API_KEY=

# Optional. If set, /api/daily-update requires this exact value as
# "Authorization: Bearer <CRON_SECRET>" -- Vercel sends that header
# automatically for cron-triggered calls when you set CRON_SECRET as a
# project env var. Leave unset locally; the check is skipped entirely
# when this isn't configured.
CRON_SECRET=
